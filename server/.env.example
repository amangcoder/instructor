# ── Local development environment ────────────────────────────────────────────
#
# Copy this file to .env and fill in the values for local development.
#
#   cp .env.example .env
#
# ⚠  LAMBDA DEPLOYMENTS: these values are NOT used in production.
#    Non-secret env vars (AWS_S3_BUCKET, SES_FROM_EMAIL, NODE_ENV, etc.) are
#    injected directly by the Lambda function configuration.
#    Secrets (JWT_SECRET, API_KEY, OTP_SALT, GEMINI_API_KEY, DATABASE_URL,
#    UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN) are injected by the
#    AWS Parameters and Secrets Lambda Extension from Secrets Manager.
#    See infra/ for the full Lambda environment config.
#
# ── Required for local dev ───────────────────────────────────────────────────

# Server port (default: 3071 per project convention).
PORT=3071

# Log level for structured JSON logging.
# Accepted values: debug | info | warn | error
#   debug  → verbose request/response logging (local dev default)
#   info   → completions only (staging)
#   error  → 5xx errors only (prod — minimises CloudWatch ingestion cost)
LOG_LEVEL=debug

# CORS allowed origins (comma-separated).
# Lambda: API Gateway handles CORS; this is only used in main.ts for local dev.
CORS_ORIGINS=http://localhost:3072

# ── Auth ─────────────────────────────────────────────────────────────────────

# JWT secret for signing/verifying access tokens.
# Lambda: populated from Secrets Manager (key: JWT_SECRET).
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-a-random-32-byte-hex-string

# JWT secret for signing/verifying refresh tokens.
# Lambda: populated from Secrets Manager (key: JWT_REFRESH_SECRET).
# Generate: openssl rand -hex 32
JWT_REFRESH_SECRET=change-me-in-production-use-a-random-32-byte-hex-string

# Simple API key for Flutter TTS requests (x-api-key header).
# Lambda: populated from Secrets Manager (key: API_KEY).
# Generate: openssl rand -hex 32
API_KEY=your-secret-api-key-here

# HMAC salt for hashing OTP codes before storing them in Neon PostgreSQL.
# Lambda: populated from Secrets Manager (key: OTP_SALT).
# Generate: openssl rand -hex 32
OTP_SALT=change-me-use-a-random-32-byte-hex-string

# ── Neon PostgreSQL (database) ────────────────────────────────────────────────
#
# Neon provides TWO connection strings — use the correct one for each purpose:
#
# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  POOLER connection string  (runtime / application queries)                  │
# │                                                                             │
# │  Host has -pooler suffix: ep-<name>-pooler.<region>.aws.neon.tech           │
# │  Routes through Neon's PgBouncer (transaction mode).                        │
# │  Use this for: DATABASE_URL in .env and in Lambda Secrets Manager.          │
# │                                                                             │
# │  ✅ Used at runtime by the NestJS DatabaseService (@neondatabase/serverless) │
# │  ✅ Perfect for Lambda — no persistent TCP connections, multiplexed pool     │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# DATABASE_URL — POOLER (runtime default, also the Lambda Secrets Manager value)
# Find in Neon dashboard: Connection Details → Connection string → Pooled connection
DATABASE_URL=postgres://user:password@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# ┌─────────────────────────────────────────────────────────────────────────────┐
# │  DIRECT connection string  (drizzle-kit migrations ONLY)                    │
# │                                                                             │
# │  Host has NO -pooler suffix: ep-<name>.<region>.aws.neon.tech               │
# │  Direct TCP connection to Neon compute — bypasses PgBouncer.                │
# │                                                                             │
# │  ✅ Required for: npx drizzle-kit generate && npx drizzle-kit migrate        │
# │  ❌ Do NOT use at runtime — every Lambda cold start opens a new TCP conn     │
# │                                                                             │
# │  Why direct for migrations?                                                 │
# │  drizzle-kit uses session-level features (SET search_path, advisory locks)  │
# │  that PgBouncer transaction mode does NOT support. Using the pooler for     │
# │  migrations will fail with: "prepared statement does not exist"             │
# └─────────────────────────────────────────────────────────────────────────────┘
#
# DATABASE_URL_DIRECT — DIRECT (migration only, do NOT use at runtime)
# Find in Neon dashboard: Connection Details → Connection string → Direct connection
DATABASE_URL_DIRECT=postgres://user:password@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require
#
# ── How to run migrations locally ───────────────────────────────────────────
#
#   1. Set DATABASE_URL_DIRECT in this .env to your Neon direct connection string.
#   2. Run:
#        cd server
#        DATABASE_URL=$DATABASE_URL_DIRECT npx drizzle-kit migrate
#   3. Verify all four tables exist:
#        psql "$DATABASE_URL_DIRECT" -f scripts/verify-schema.sql
#   4. Confirm DATABASE_URL (pooler) is set correctly for runtime queries.
#
# ── Lambda production migrations ────────────────────────────────────────────
#
#   Migrations are run LOCALLY before each deployment — NOT at Lambda startup.
#   Use the direct connection string when running migrations against prod/staging.
#   DATABASE_URL in Lambda Secrets Manager should always be the POOLER string.
#
# Neon: https://neon.tech (free tier — 0.5 GB storage, 1 project, 10 branches)

# ── Upstash Redis (rate limiting / cache) ─────────────────────────────────────
#
# Upstash Redis accessed via HTTP REST API (zero TCP connections, free tier
# supports up to 10 000 commands/day on a shared cluster).
# Lambda: injected by the AWS Parameters and Secrets Lambda Extension from
#         Secrets Manager (key path: instructor/<env>/UPSTASH_REDIS_REST_URL
#         and instructor/<env>/UPSTASH_REDIS_REST_TOKEN).
# Local dev: create a free Upstash database at https://upstash.com, then copy
#            the REST URL and REST Token from the database dashboard.

UPSTASH_REDIS_REST_URL=https://example-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token-here

# ── AWS SES (email / OTP) ─────────────────────────────────────────────────────
#
# SES sender address — must be verified in the AWS SES console before use.
# Lambda: set in the Lambda function environment configuration.
# Local dev: use a verified personal email if testing real email delivery,
#            or mock SESEmailService in tests.

SES_FROM_EMAIL=instructor.app@layersiq.com

# ── Sentry (error tracking) ──────────────────────────────────────────────────
#
# Lambda: passed via CDK context (cdk deploy --context sentryDsn=https://...).
# Local dev: set to your Sentry project DSN.
# Leave blank to disable Sentry.
SENTRY_DSN=

# ── Gemini ────────────────────────────────────────────────────────────────────
#
# Lambda: populated from Secrets Manager (key: GEMINI_API_KEY).
# Obtain from: https://aistudio.google.com/app/apikey

GEMINI_API_KEY=your-gemini-api-key-here

# ── Kokoro TTS (optional) ─────────────────────────────────────────────────────
#
# URL of the standalone Kokoro Python TTS server.
# Lambda: populated from Secrets Manager (key: KOKORO_SERVER_URL) if set.
# Local dev without Docker: http://127.0.0.1:3070
# Leave blank to disable Kokoro (Gemini-only mode).

KOKORO_SERVER_URL=http://127.0.0.1:3070

# ── S3 (TTS cache + user sync backups) ───────────────────────────────────────
#
# Lambda: set automatically by CDK (AWS_S3_BUCKET=instructor-cache[-<env>]).
# Local dev: create an S3 bucket or use a LocalStack instance.
# Leave blank to disable S3 (local disk TTS cache only; sync returns 503).

AWS_S3_BUCKET=instructor-cache
AWS_REGION=ap-south-1

# AWS credentials for local dev (SDK default credential chain).
# Lambda: credentials are provided automatically via the execution role.
# Local dev options:
#   1. AWS_PROFILE — named profile in ~/.aws/credentials (recommended)
#   2. AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY — explicit static credentials
AWS_PROFILE=default

# ── Lambda-specific (not used for local main.ts) ──────────────────────────────
#
# These are set automatically by the CDK stack in the Lambda environment.
# Only needed here if you are testing lambda.ts locally (e.g. with SAM CLI).

# Secrets Manager secret name containing JWT_SECRET, API_KEY, OTP_SALT, GEMINI_API_KEY.
# Set by CDK: instructor/<env>/app-secrets
# APP_SECRETS_ID=instructor/dev/app-secrets

# Port the AWS Parameters and Secrets Lambda Extension listens on.
# PARAMETERS_SECRETS_EXTENSION_HTTP_PORT=2773

# Cache TTL for secrets (seconds). 300 = 5 minutes.
# SECRETS_MANAGER_TTL=300
