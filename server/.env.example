# ── Server ───────────────────────────────────────────────────────────────────

# Server port (default: 3071).
PORT=3071

# CORS allowed origins (comma-separated, default: http://localhost:3072).
CORS_ORIGINS=http://localhost:3072

# ── Auth ─────────────────────────────────────────────────────────────────────

# JWT secret for signing/verifying access tokens.
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-a-random-32-byte-hex-string

# Simple API key for Flutter app TTS requests (x-api-key header).
# Can be omitted in favour of JWT auth — but then all TTS requests need a JWT.
# Generate: openssl rand -hex 32
API_KEY=your-secret-api-key-here

# HMAC salt for hashing OTP codes before storing them.
# Generate: openssl rand -hex 32
OTP_SALT=change-me-use-a-random-32-byte-hex-string

# ── Email / OTP ───────────────────────────────────────────────────────────────
# If SMTP vars are not set, Ethereal test account is used in development.
# Get real SMTP credentials from your email provider (e.g. SendGrid, Mailgun).

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM="Instructor App <noreply@instructor.app>"

# ── Gemini ────────────────────────────────────────────────────────────────────

# Gemini API key for TTS and plan generation.
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# ── Kokoro TTS (optional) ─────────────────────────────────────────────────────

# URL of the standalone Kokoro Python TTS server (TASK-004).
# When using docker-compose, this is automatically set to http://kokoro:3070.
# For local dev without Docker: http://127.0.0.1:3070
# Leave blank or omit to disable Kokoro (Gemini-only mode).
KOKORO_SERVER_URL=http://127.0.0.1:3070

# ── Redis (rate limiting) ────────────────────────────────────────────────────
#
# Redis connection URL for distributed rate limiting.
# When using docker-compose, this is automatically set to redis://redis:6379.
# For local dev without Docker: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# ── Database ─────────────────────────────────────────────────────────────────

# Directory where the server-side SQLite database is stored.
# Default: <project_root>/data/server.db
DATABASE_DIR=./data

# ── S3 (sync + TTS cache) ─────────────────────────────────────────────────────
#
# S3 bucket for:
#   - TTS audio cache: tts/{hash}.wav
#   - User database backups: backups/{userId}/instructor.db
#
# AWS credentials are resolved by the SDK's default credential chain:
#   1. AWS_PROFILE → named profile in ~/.aws/credentials (local dev)
#   2. IAM role attached to the EC2/ECS instance (production)
#
# Leave AWS_S3_BUCKET blank to disable S3 (local disk only for TTS;
# sync endpoints will return 503 Service Unavailable).

AWS_S3_BUCKET=instructor-cache
AWS_REGION=ap-south-1
AWS_PROFILE=default
